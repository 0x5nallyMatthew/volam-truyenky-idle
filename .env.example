# ============================================================
# Võ Lâm Idle - Cấu hình máy chủ (file này KHÔNG commit lên git)
# Copy thành ".env" rồi điền giá trị thật.
# Máy chủ tự đọc file .env khi chạy `node server/index.js`.
# ============================================================

# --- Supabase (bảng xếp hạng / lưu đám mây / chat / tổ đội) ---
# Project URL: Supabase -> Settings -> API
SUPABASE_URL=
# service_role key - CHỈ dùng phía máy chủ, đứng qua RLS
SUPABASE_SERVICE_KEY=
# anon/public key (dự phòng, khi không có service key)
SUPABASE_KEY=

# --- Máy chủ ---
# Cổng HTTP (mặc định 8080)
PORT=8080
# Địa chỉ lắng nghe: 0.0.0.0 để bạn bè cùng LAN vào được qua http://<IP-máy>:8080
HOST=0.0.0.0
# Chuỗi bí mật ký token đăng nhập (để trống: máy chủ tự sinh và lưu vào server/.secret)
TOKEN_SECRET=
# Mã truy cập trang quản trị /gm (đặt giá trị rỗng "" để TẮT trang quản trị)
GM_TOKEN=
# Cho phép domain khác gọi API (để trống: chỉ cho phép cùng origin - an toàn)
CORS_ORIGIN=
